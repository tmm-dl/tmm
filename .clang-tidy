---
Checks: "*,
        -abseil-*,
        -altera-*,
        -android-*,
        -fuchsia-*,
        -google-*,
        -llvm*,
        -modernize-use-trailing-return-type,
        -zircon-*,
        -readability-else-after-return,
        -readability-static-accessed-through-instance,
        -readability-avoid-const-params-in-decls,
        -cppcoreguidelines-non-private-member-variables-in-classes,
        -misc-non-private-member-variables-in-classes,
        -misc-no-recursion,
        -misc-use-anonymous-namespace,
        -misc-use-internal-linkage,
        -hicpp-uppercase-literal-suffix,
        -readability-uppercase-literal-suffix,
        -misc-include-cleaner
"
WarningsAsErrors: ''
HeaderFilterRegex: ''
FormatStyle:     none

CheckOptions:
  # Short identifier names that are conventional in this codebase:
  #   h   — opaque handle parameter in C ABI vtables (ubiquitous in COM-style APIs)
  #   vt  — vtable pointer / reference (avoids "vtable" vs "v_table" inconsistency)
  #   n   — byte count in read() / stream APIs (established C++ stream convention)
  #   p   — loop variable over plugins (too short to be useful when context is clear)
  #   r   — single-use expected/result variable in narrow call sites
  #   it  — iterator (conventional abbreviation accepted by most style guides)
  #   sp  — seekpos parameter (matches std::streambuf::seekpos naming)
  #   s   — sentinel-loop variable for null-terminated char** arrays
  #   c   — a single character
  - key: readability-identifier-length.IgnoredVariableNames
    value: 'x|y|z|p|r|it|sp|c'
  - key: readability-identifier-length.IgnoredParameterNames
    value: 'x|y|z|h|vt|n|s|c'
